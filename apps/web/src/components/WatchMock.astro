---
import HammockMark from "./HammockMark.astro";
---

{/* A real illustration of the watch UI — not a fake screenshot.
    The sway is the same ambient token the app uses. */}
<div class="watch" role="img" aria-label="The Siesta app on a watch, waiting for sleep">
  <div class="crown" aria-hidden="true"></div>
  <div class="face">
    <HammockMark size={58} animated />
    <p class="mins">20<span class="unit"> min</span></p>
    <p class="status">Waiting for sleep…</p>
  </div>
</div>

<style>
  .watch {
    position: relative;
    width: min(280px, 68vw);
    aspect-ratio: 0.82;
    margin-inline: auto;
  }
  .crown {
    position: absolute;
    top: 22%;
    right: -2.5%;
    width: 4%;
    height: 12%;
    border-radius: 999px;
    background: var(--surface-elevated);
  }
  .face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-radius: 27%;
    background:
      radial-gradient(140% 100% at 50% 0%, var(--surface-elevated) 0%, var(--surface) 46%, #151110 100%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 9%, transparent),
      inset 0 -18px 44px color-mix(in srgb, #000 55%, transparent),
      0 40px 80px -24px color-mix(in srgb, #000 80%, transparent);
  }
  .mins {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    letter-spacing: -0.02em;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .unit {
    font-size: 0.38em;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0;
  }
  .status {
    margin: 0;
    font-size: 0.72rem;
    color: var(--text-tertiary);
    letter-spacing: 0.01em;
  }
</style>
