---
import HammockMark from "./HammockMark.astro";
---

{/* A real illustration of the watch UI — not a fake screenshot.
    The face quietly cycles through the three states the product actually
    shows: waiting → sleeping → welcome back. ~12s loop, paused under
    prefers-reduced-motion. */}
<div class="watch" role="img" aria-label="The Siesta app on a watch with a start button and duration selector">
  <div class="crown" aria-hidden="true"></div>
  <div class="face">
    <HammockMark size={58} animated />
    <div class="mock-start">Start siesta</div>
    <div class="readout">
      <p class="mins state-wait">20<span class="unit"> min</span></p>
      <p class="mins state-sleep">18:47</p>
      <p class="mins state-wake"><span class="greet">Welcome back.</span></p>
      <p class="status s-wait">Waiting for sleep…</p>
      <p class="status s-sleep">sleeping</p>
      <p class="status s-wake">20 min siesta</p>
    </div>
    <div class="mock-presets" aria-hidden="true"><span>15</span><strong>20</strong><span>25</span></div>
  </div>
</div>

<style>
  .watch {
    position: relative;
    width: min(280px, 68vw);
    aspect-ratio: 0.82;
    margin-inline: auto;
    /* Gentle levitation — the watch hangs in the dusk like the hammock
       hangs in the frame. ±3px over 7s, felt more than seen. */
    animation: bob 7s ease-in-out infinite alternate;
  }
  @keyframes bob {
    from { transform: translateY(-3px); }
    to   { transform: translateY(3px); }
  }
  .crown {
    position: absolute;
    top: 22%;
    right: -2.5%;
    width: 4%;
    height: 12%;
    border-radius: 999px;
    background: var(--surface-elevated);
  }
  .face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    border-radius: 27%;
    background:
      radial-gradient(140% 100% at 50% 0%, var(--surface-elevated) 0%, var(--surface) 46%, var(--brand-hammock) 78%, var(--scrim) 100%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 9%, transparent),
      inset 0 -18px 44px color-mix(in srgb, var(--accent-soft) 24%, transparent),
      0 40px 80px -24px color-mix(in srgb, var(--text-primary) 30%, transparent);
    animation: faceglow 12s ease-in-out infinite;
  }
  .mock-start {
    padding: 0.48rem 1.15rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.76rem;
    font-weight: 600;
  }
  .readout {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
  }
  .mock-presets {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-tertiary);
    font-size: 0.66rem;
  }
  .mock-presets strong {
    color: var(--accent);
    font-size: 0.82rem;
  }
  .mins {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    letter-spacing: -0.02em;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    grid-area: 1 / 1;
  }
  .unit {
    font-size: 0.38em;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0;
  }
  .greet {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-size: 0.5em;
    font-weight: 480;
    letter-spacing: -0.01em;
  }
  .status {
    margin: 0;
    font-size: 0.72rem;
    color: var(--text-tertiary);
    letter-spacing: 0.01em;
    grid-area: 2 / 1;
  }
  .s-sleep { color: var(--accent); }

  /* The three app states, crossfaded on one 12s timeline. */
  .state-wait  { animation: cycle-wait  12s ease-in-out infinite; }
  .state-sleep { animation: cycle-sleep 12s ease-in-out infinite; }
  .state-wake  { animation: cycle-wake  12s ease-in-out infinite; }
  .s-wait      { animation: cycle-wait  12s ease-in-out infinite; }
  .s-sleep     { animation: cycle-sleep 12s ease-in-out infinite; }
  .s-wake      { animation: cycle-wake  12s ease-in-out infinite; }

  @keyframes cycle-wait {
    0%, 26%   { opacity: 1; transform: none; }
    33%, 100% { opacity: 0; transform: translateY(-4px); }
  }
  @keyframes cycle-sleep {
    0%, 26%   { opacity: 0; transform: translateY(4px); }
    33%, 59%  { opacity: 1; transform: none; }
    66%, 100% { opacity: 0; transform: translateY(-4px); }
  }
  @keyframes cycle-wake {
    0%, 59%   { opacity: 0; transform: translateY(4px); }
    66%, 93%  { opacity: 1; transform: none; }
    100%      { opacity: 0; transform: translateY(-4px); }
  }
  /* The face itself brightens a touch on the wake beat (§14). */
  @keyframes faceglow {
    0%, 62%   { filter: brightness(1); }
    72%, 88%  { filter: brightness(1.14); }
    100%      { filter: brightness(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .state-wait, .state-sleep, .state-wake,
    .s-wait, .s-sleep, .s-wake, .face, .watch {
      animation: none;
    }
    .state-sleep, .state-wake, .s-sleep, .s-wake { opacity: 0; }
  }
</style>
