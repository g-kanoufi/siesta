---
interface Props {
  size?: number;
  animated?: boolean;
}
const { size = 40, animated = false } = Astro.props;
---

<svg
  class:list={["hammock", { sway: animated }]}
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="siesta-sunset" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--logo-dawn)" />
      <stop offset=".44" stop-color="var(--logo-ember)" />
      <stop offset="1" stop-color="var(--logo-dusk)" />
    </linearGradient>
    <linearGradient id="siesta-fabric" x1=".12" y1=".05" x2=".86" y2="1">
      <stop offset="0" stop-color="var(--brand-hammock)" />
      <stop offset=".46" stop-color="#1B2B45" />
      <stop offset="1" stop-color="var(--brand-hammock-shade)" />
    </linearGradient>
  </defs>
  <rect width="1024" height="1024" rx="220" fill="url(#siesta-sunset)" />
  <g transform="translate(0 -39)">
    <path
      d="M112 342 C170 342 205 420 245 480 C315 575 400 610 512 610 C624 610 709 575 779 480 C819 420 854 342 912 342 L912 430 C854 430 819 500 780 560 C710 660 625 760 512 760 C399 760 314 660 244 560 C203 500 168 430 112 430 Z"
      fill="url(#siesta-fabric)"
    />
    <path
      d="M112 342 C170 342 205 420 245 480 C315 575 400 610 512 610 C624 610 709 575 779 480 C819 420 854 342 912 342 L912 390 C854 390 819 448 780 510 C710 586 625 645 512 645 C399 645 314 586 244 510 C203 448 168 390 112 390 Z"
      fill="var(--brand-hammock)"
      opacity=".48"
    />
    <path
      d="M112 390 C168 390 203 448 244 510 C314 586 399 645 512 645 C625 645 710 586 780 510 C819 448 854 390 912 390"
      stroke="var(--brand-hammock-shade)"
      stroke-opacity=".82"
      stroke-width="12"
      stroke-linecap="round"
    />
  </g>
</svg>

<style>
  .hammock {
    display: block;
    flex: none;
  }
  .hammock.sway {
    animation: sway var(--sway-period) ease-in-out infinite;
    transform-origin: 50% 0%;
  }
  @media (prefers-reduced-motion: reduce) {
    .hammock.sway {
      animation: none;
    }
  }
</style>
