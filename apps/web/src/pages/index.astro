---
import "@fontsource-variable/fraunces";
import "@fontsource/instrument-sans";
import "../styles/global.css";
import { ambient, dark, sunset } from "@siesta/design-tokens";
import HammockMark from "../components/HammockMark.astro";
import WatchMock from "../components/WatchMock.astro";

const cssVars = {
  "--bg": dark.background,
  "--surface": dark.surface,
  "--surface-elevated": dark.surfaceElevated,
  "--text-primary": dark.textPrimary,
  "--text-secondary": dark.textSecondary,
  "--text-tertiary": dark.textTertiary,
  "--accent": dark.accent,
  "--on-accent": dark.onAccent,
  "--accent-soft": dark.accentSoft,
  "--scrim": dark.scrim,
  "--font-display": '"Fraunces Variable", Georgia, serif',
  "--font-body": '"Instrument Sans", system-ui, sans-serif',
  "--sway-period": `${ambient.sway.periodMs}ms`,
  "--sway-deg": `${ambient.sway.amplitudeDegrees}deg`,
  "--sky-zenith": sunset.zenith,
  "--sky-rose": sunset.rose,
  "--sky-coral": sunset.coral,
  "--sky-ember": sunset.ember,
  "--sky-horizon": sunset.horizon,
};

const steps = [
  {
    n: "01",
    title: "Choose a duration",
    body: "Five minutes to two hours. Twenty is the classic siesta.",
  },
  {
    n: "02",
    title: "Put the watch down",
    body: "No countdown yet. Siesta waits quietly while you settle.",
  },
  {
    n: "03",
    title: "Drift",
    body: "Your watch reads your heart rate settle into sleep. The timer starts then — not before.",
  },
  {
    n: "04",
    title: "Wake",
    body: "Gentle haptics on your wrist, exactly when you asked. Not a second of nap wasted on setup.",
  },
];
---

<html lang="en" style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Siesta — a nap timer that waits for sleep</title>
    <meta
      name="description"
      content="Pick a duration, put your watch down, drift off. Siesta notices when you fall asleep and wakes you gently when it's over. €2.99, once. No subscription, no ads."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Siesta — a nap timer that waits for sleep" />
    <meta
      property="og:description"
      content="Choose how long you want to nap. Siesta notices when you actually fall asleep — and wakes you gently, right on time."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://siesta.app" />
    <meta property="og:image" content="https://siesta.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Siesta — a nap timer that waits for sleep" />
    <meta
      name="twitter:description"
      content="Choose how long you want to nap. Siesta notices when you actually fall asleep — and wakes you gently, right on time."
    />
    <meta name="twitter:image" content="https://siesta.app/og.png" />
    <meta name="theme-color" content={dark.background} />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Siesta",
        "applicationCategory": "HealthApplication",
        "operatingSystem": "watchOS, Wear OS",
        "offers": {
          "@type": "Offer",
          "price": "2.99",
          "priceCurrency": "EUR"
        },
        "description": "A tiny nap timer that waits for you to fall asleep. Choose a duration, drift off, wake gently on time."
      }
    </script>
  </head>
  <body>
    <header class="nav rise">
      <a class="wordmark" href="/" aria-label="Siesta home">
        <HammockMark size={30} />
        <span>siesta</span>
      </a>
      <span class="nav-price">€2.99 · once</span>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow rise" style="animation-delay:.05s">A nap timer for your wrist</p>
          <h1 class="rise" style="animation-delay:.12s">
            Sleep first.<br />Count down second.
          </h1>
          <p class="lede rise" style="animation-delay:.2s">
            Pick a duration, put the watch down, drift off. Siesta is built to
            notice the moment you actually fall asleep — the timer starts
            then, not before.
          </p>
          <p class="failsafe-line rise" style="animation-delay:.24s">
            Can't tell you're asleep? You still wake on time — worst case,
            it's the calmest ordinary nap timer on your wrist.
          </p>
          <div class="cta rise" style="animation-delay:.28s">
            <a class="pill" href="#price">€2.99 · one purchase</a>
            <span class="store-pill">Coming to Apple&nbsp;Watch</span>
            <span class="store-pill">Coming to Wear&nbsp;OS</span>
          </div>
        </div>
        <div class="hero-watch rise" style="animation-delay:.18s">
          <div class="sun" aria-hidden="true"></div>
          <WatchMock />
        </div>
      </section>

      <section class="steps reveal" aria-labelledby="how">
        <h2 id="how" class="section-label">How it works</h2>
        <ol>
          {
            steps.map((s) => (
              <li>
                <span class="step-n">{s.n}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="honest reveal">
        <h2 class="display-small">Made to notice you drift off. Made to wake you anyway.</h2>
        <p>
          Most nap timers guess the moment you lie down and start counting.
          Siesta doesn't. Your watch streams your heart rate, and the app
          waits for the settled pattern of real sleep onset before the clock
          begins.
        </p>
        <p>
          <strong class="promise">And it works either way.</strong> A fail-safe
          wake is locked in the moment you start a siesta. If detection never
          fires — tonight you're still, warm and awake — the countdown simply
          runs from the start and wakes you like a normal timer. No missed
          alarm, no wasted nap.
        </p>
        <p>
          Your health data never leaves your wrist. There are no servers, no
          account, nothing to sync — the whole app lives on the watch.
        </p>
        <p class="fine">
          Siesta is a better nap, not a medical device. Detection is a
          heuristic — good enough for a nap, honest about everything else.
        </p>
      </section>

      <section class="faq reveal" aria-labelledby="faq">
        <h2 id="faq" class="section-label">Fair questions</h2>
        <details>
          <summary>How does it know I fell asleep?</summary>
          <p>
            While Siesta waits, your watch streams heart rate and motion. When
            your pulse settles below its resting line and stays settled — and
            your wrist goes still — the timer starts, credited back to the
            moment the settling began. It's a good heuristic, not a sleep lab.
          </p>
        </details>
        <details>
          <summary>What if it can't tell?</summary>
          <p>
            A fail-safe wake is set the moment you arm a nap. If detection never
            fires, you're still woken on time — the worst case is an ordinary,
            honest nap timer. You can also start a plain timer with one tap.
          </p>
        </details>
        <details>
          <summary>Does it need my phone nearby?</summary>
          <p>
            No. Detection, the countdown, and the wake all run on the watch.
            Nothing syncs; there's no account.
          </p>
        </details>
        <details>
          <summary>What about battery?</summary>
          <p>
            The sensor stream is the whole trick, so the goal is a 90-minute
            nap under ~5% — measured on real hardware before we promise it,
            not simulated.
          </p>
        </details>
        <details>
          <summary>Which watches?</summary>
          <p>
            Apple Watch on watchOS 11+, and Wear OS watches with a heart-rate
            sensor. The iPhone and Android companions stay minimal — the watch
            is the product.
          </p>
        </details>
      </section>

      <section class="price reveal" id="price">
        <h2 class="price-figure"><span class="cur">€</span>2.99</h2>
        <p class="price-word">once</p>
        <p>
          One purchase on the watch you already own. No subscription, no ads,
          no metrics, no upsell — a nap timer shouldn't need a business model
          beyond being bought.
        </p>
      </section>
    </main>

    <footer class="footer">
      <HammockMark size={26} />
      <p>siesta.app</p>
      <p class="fine">Designed to be forgotten the moment you lie down.</p>
    </footer>

    {/* Sections rise gently as they enter view. Everything is visible without
        JS or under reduced motion — .revealable is only ever added by JS,
        and the reveal is opacity + transform, never layout. */}
    <script>
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduced && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -12% 0px" }
        );
        document.querySelectorAll(".reveal").forEach((el) => {
          el.classList.add("revealable");
          io.observe(el);
        });
      }
    </script>
  </body>
</html>

<style>
  .nav {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  /* A tiny bit of life on hover — the hammock gives one slow swing. */
  .wordmark:hover .hammock {
    animation: sway var(--sway-period) ease-in-out 1;
    transform-origin: 50% 0%;
  }
  .nav-price {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
  }

  main {
    position: relative;
    z-index: 1;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4rem) clamp(2.5rem, 6vw, 5rem);
    max-width: 72rem;
    margin-inline: auto;
  }
  .eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.4rem;
  }
  h1 {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-weight: 480;
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
  }
  .lede {
    max-width: 30rem;
    margin-top: 1.6rem;
    color: var(--text-secondary);
    font-size: 1.125rem;
  }
  /* The promise, up front — detection is the ambition, the wake is the
     guarantee. Sits a breath below the lede, smaller but warmer. */
  .failsafe-line {
    max-width: 30rem;
    margin-top: 1rem;
    font-size: 0.98rem;
    color: var(--text-secondary);
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
  }
  /* The last of the sun, caught behind the watch face — a soft ember disc
     that gives the hero its horizon. */
  .hero-watch {
    position: relative;
  }
  .sun {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 130%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle,
      color-mix(in srgb, var(--sky-ember) 30%, transparent) 0%,
      color-mix(in srgb, var(--sky-coral) 14%, transparent) 38%,
      transparent 66%);
    animation: sunbreathe 9s ease-in-out infinite alternate;
  }
  @keyframes sunbreathe {
    from { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
    to   { opacity: 1;   transform: translate(-50%, -52%) scale(1.04); }
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    margin-top: 2.4rem;
  }
  .pill {
    display: inline-block;
    padding: 0.85rem 1.7rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }
  .pill:hover {
    color: var(--on-accent);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 32px -8px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .pill:active {
    transform: translateY(0) scale(0.96);
    transition-duration: 0.08s;
  }
  .platforms {
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }
  .store-pill {
    display: inline-block;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--text-tertiary) 35%, transparent);
    font-size: 0.8rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.3s ease,
      color 0.3s ease;
  }
  .store-pill:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--text-primary);
  }

  .steps {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.25rem, 5vw, 4rem);
  }
  .section-label {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 2.8rem;
  }
  .steps ol {
    list-style: none;
    display: grid;
    gap: 2.6rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.4rem;
    align-items: baseline;
  }
  .step-n {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-size: 1.4rem;
    color: var(--accent);
    font-weight: 400;
  }
  .steps h3 {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 60;
    font-weight: 520;
    font-size: 1.45rem;
    margin-bottom: 0.35rem;
  }
  .steps p {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .honest {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.25rem, 5vw, 4rem);
  }
  .display-small {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100, "opsz" 72;
    font-weight: 480;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    letter-spacing: -0.01em;
    margin-bottom: 1.8rem;
  }
  .honest p {
    color: var(--text-secondary);
    margin-bottom: 1.1rem;
  }
  .honest .fine {
    color: var(--text-tertiary);
    font-size: 0.9rem;
    margin-top: 1.8rem;
  }
  .promise {
    color: var(--accent);
    font-weight: 600;
  }

  .faq {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 3rem) clamp(1.25rem, 5vw, 4rem) clamp(3rem, 8vw, 6rem);
  }
  .faq details {
    border-bottom: 1px solid color-mix(in srgb, var(--text-tertiary) 18%, transparent);
    padding: 1.05rem 0;
  }
  .faq details:first-of-type {
    border-top: 1px solid color-mix(in srgb, var(--text-tertiary) 18%, transparent);
  }
  .faq summary {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 60;
    font-weight: 520;
    font-size: 1.15rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    transition: color 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .faq summary:hover {
    color: var(--accent);
    transform: translateX(3px);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "+";
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--accent);
    transition: transform 0.25s ease;
    flex: none;
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq details p {
    margin-top: 0.7rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
  }

  .price {
    text-align: center;
    padding: clamp(3rem, 9vw, 8rem) 1.25rem;
  }
  .price-figure {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-weight: 460;
    font-size: clamp(4.5rem, 14vw, 9rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 0 60px color-mix(in srgb, var(--sky-ember) 22%, transparent);
  }
  .cur {
    color: var(--accent);
    font-size: 0.55em;
    vertical-align: 0.14em;
  }
  .price-word {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-size: 1.5rem;
    color: var(--text-tertiary);
    margin: 0.6rem 0 2rem;
  }
  .price p:last-child {
    max-width: 34rem;
    margin-inline: auto;
    color: var(--text-secondary);
  }

  .footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    padding: 4rem 1.25rem 3rem;
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }
  .footer .fine {
    color: color-mix(in srgb, var(--text-tertiary) 70%, transparent);
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 2rem;
    }
    .hero-watch {
      order: -1;
    }
    .watch {
      width: min(220px, 60vw);
    }
    h1 {
      font-size: clamp(2.4rem, 9vw, 3.4rem);
    }
  }
</style>
