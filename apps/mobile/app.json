{
  "expo": {
    "name": "Siesta",
    "slug": "siesta",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "siesta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.siesta",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.siesta"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.siesta",
      "adaptiveIcon": {
        "backgroundColor": "#F4C56C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/with-domain-sync.js",
      "@bacons/apple-targets"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "app.siesta.watch",
                  "targetName": "SiestaWatch",
                  "entitlements": {
                    "com.apple.developer.healthkit": true,
                    "com.apple.developer.healthkit.access": [],
                    "com.apple.security.application-groups": [
                      "group.app.siesta"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "app.siesta.watch.widget",
                  "targetName": "SiestaComplication"
                }
              ]
            }
          }
        },
        "projectId": "f1a7a762-da0a-4204-b513-72015350381f"
      }
    },
    "owner": "guiknf-org"
  }
}
